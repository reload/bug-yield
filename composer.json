{
  "name": "reload/bugyield",
  "description": "A script to sync between Harvest and Jira.",
  "license": "MIT",
  "autoload" : {
    "psr-4": {
      "BugYield\\": "src/"
    }
  },
  "config": {
    "platform": {
      "php": "8.5.0"
    }
  },
  "require": {
    "php": ">=8.5.0",
    "ext-curl": "*",
    "ext-xml": "*",
    "ext-mbstring": "*",
    "ext-gmp": "*",
    "gridonic/hapi": "dev-master",
    "symfony/console": "^5",
    "symfony/yaml": "^5",
    "alexkovalevych/jira-api": ">=1.0.6",
    "mnapoli/silly-php-di": ">=1.2",
    "sendgrid/sendgrid": "^8.1"
  },
  "require-dev": {
    "phpspec/phpspec": "^8",
    "squizlabs/php_codesniffer": "^4.0",
    "friends-of-phpspec/phpspec-code-coverage": "^7.0"
  }
}
